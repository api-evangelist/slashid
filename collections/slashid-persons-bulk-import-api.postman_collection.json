        {
          "id": "c1cbd452-3e35-4c45-af26-0d568625ffaf",
          "name": "Bulk import persons",
          "request": {
            "name": "Bulk import persons",
            "description": {
              "content": "Bulk import persons into your organization by uploading a CSV file.\n\nThe import will take the following CSV column headers into consideration:\n\n\"slashid:emails\",\"slashid:phone_numbers\",\"slashid:usernames\",\"slashid:region\",\"slashid:groups\",\"slashid:attributes\"\n\nEach row in the CSV must contain at least one handle for the person\n(email address, phone number, or a username). Optionally, you can\nspecify a list of roles, a geographical region and attributes.\nAttributes are a JSON-encoded map from attribute bucket names to\nkey-value pairs. Email addresses, phone numbers, and usernames must be\ncomma-separated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "persons",
                "bulk-import"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The organization ID",
                "key": "SlashID-OrgID",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "persons",
                  "type": "file",
                  "description": "(Required) File in CSV format that contains the persons to import."
                }
              ]
            }
          },

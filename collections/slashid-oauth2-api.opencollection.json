{
  "opencollection": "1.0.0",
  "info": {
    "name": "SlashID Groups OAuth2 API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "SlashID-API-Key",
      "value": "{{SlashID-API-Key}}",
      "placement": "header"

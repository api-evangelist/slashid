                "value": ""
              },
              {
                "name": "SlashID-Required-Consistency-Timeout",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "oauth_client_id",
                "value": "",
                "type": "path",
                "description": "An OAuth client ID"
              }
            ]
          },
          "docs": "A new client secret is created and returned. The previous secret will no longer be valid after this.\n"
        },
        {

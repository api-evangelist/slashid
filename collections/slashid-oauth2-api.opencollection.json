        {
          "info": {
            "name": "Obtain an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.slashid.com/oauth2/tokens",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Obtain a new OAuth 2.0 access token using an OAuth 2.0 client ID/secret pair.\n"
        },

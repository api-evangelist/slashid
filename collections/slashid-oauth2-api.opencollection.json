                "value": ""
              },
              {
                "name": "SlashID-Required-Consistency-Timeout",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "oauth_client_id",
                "value": "",
                "type": "path",
                "description": "An OAuth client ID"
              }
            ]
          },
          "docs": "Delete the identified client. Authenticated with a SlashID organization ID and API key; the organization ID must match or be a parent of the client owner.\n"
        },
        {
          "info": {
            "name": "Generate a new client secret",
            "type": "http"

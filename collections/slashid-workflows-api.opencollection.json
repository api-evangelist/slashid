        {
          "info": {
            "name": "Activate workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.slashid.com/workflows/:workflow_id/activate",
            "headers": [
              {
                "name": "SlashID-OrgID",
                "value": "af5fbd30-7ce7-4548-8b30-4cd59cb2aba1"
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path",
                "description": "Workflow identifier"
              }
            ]
          },
          "docs": "Activate a workflow to make it operational"

              "raw": "[\n  {\n    \"event_name\": \"RolesSetToPerson_InRegion_v1\",\n    \"count\": 1,\n    \"duplicates\": false,\n    \"analytics_correlation_id\": \"\"\n  },\n  {\n    \"event_name\": \"RolesSetToPerson_InRegion_v1\",\n    \"count\": 1,\n    \"duplicates\": false,\n    \"analytics_correlation_id\": \"\"\n  }\n]",
